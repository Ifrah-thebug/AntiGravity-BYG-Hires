# Copy this file to `.env` (same folder) and fill in the values.
# Use the same values as the web app's VITE_* variables in the root .env.

# Supabase (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Express backend. Live API is served from the site domain (https://byghires.com/api/...).
# For local testing instead:
#   Android emulator -> http://10.0.2.2:5001
#   iOS simulator    -> http://localhost:5001
#   Real phone       -> http://<your-PC-LAN-IP>:5001
BACKEND_URL=https://byghires.com

# Public web app URL — used for portfolio share links
WEB_APP_URL=https://byghires.com

# Gemini key used for CV parsing on signup (VITE_GEMINI_API_KEY)
GEMINI_API_KEY=

# Vapi voice interview (VITE_VAPI_PUBLIC_KEY / VITE_VAPI_ASSISTANT_ID)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
