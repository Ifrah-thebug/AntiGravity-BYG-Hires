<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only. byghires.com uses a Let's Encrypt certificate that chains to ISRG Root X1, which
  Android 7.0 (API 24) does not ship (added in 7.1.1). Bundling the ISRG roots lets those phones
  reach the API; newer Android versions already trust them through the system store.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
